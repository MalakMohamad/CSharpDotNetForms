<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Form2Practicing4.MainWindow"
        Title="Form2Practicing4">
    <!-- 
    Build a complete restaurant order form.

    Controls: CheckBoxes, RadioButtons, Buttons, TextBlocks.

    Requirements:
    - Food: Burger (35 SAR), Pizza (29 SAR), Pasta (40 SAR).
    - Drink: Water (1 SAR), Juice (5 SAR), Coffee (8 SAR).
    - Choose one order type: Dine-in or Takeaway.
    - Add a 5 SAR packaging fee for Takeaway.
    - Place Order displays all selected items, order type, and final price.
    - Clear Order resets all controls and output.
    - Display a message if no food is selected.
    Extra challenge: Add a confirmation dialog before placing the order.
-->
    <StackPanel Background="AliceBlue">
       <GroupBox Margin="20 30 0 0"
                 Width="500"
                 HorizontalAlignment="Left"
                 Header="MENU"
                 FontWeight="DemiBold"
                 >
        <Grid ColumnDefinitions="*,*" ColumnSpacing="5" HorizontalAlignment="Left">
            <StackPanel Grid.Column="0" Margin="20 10 0 0 " >
            <CheckBox  Name="BurgerCheckBox" Content="Burger (35 SAR)" Margin="10"></CheckBox>
            <CheckBox Name="PizzaCheckBox" Content="Pizza (29 SAR)" Margin="10"></CheckBox>
            <CheckBox Name="PastaCheckBox" Content="Pasta (40 SAR)" Margin="10"></CheckBox>
        </StackPanel>
          
        <StackPanel  Grid.Column="1"  Margin="20 10 0 0 " >
            <CheckBox  Name="WaterCheckBox" Content="Water (1 SAR)" Margin="10"></CheckBox>
            <CheckBox Name="JuiceCheckBox" Content="Juice (5 SAR)" Margin="10"></CheckBox>
            <CheckBox Name="CoffeeCheckBox" Content="Coffee (8 SAR)" Margin="10"></CheckBox>
        </StackPanel>
        </Grid>
       </GroupBox>
      
        <GroupBox Margin="20 10 0 0 "
                  Header="Order Type"
                  FontWeight="DemiBold"
                  Width="200"
                  HorizontalAlignment="Left"
                  >
            <StackPanel>
            <RadioButton  Name="DineRadioButton"
                          GroupName="OrderType" 
                          Content="Dine-in"
                          Margin="30 0 0 0 "></RadioButton>
        <RadioButton Name="TakeRadioButton"
                     GroupName="OrderType" 
                     Content="Takeaway (5 SAR)"
                     Margin="30 5 0 0 "></RadioButton>
            </StackPanel>   
        </GroupBox>
        <TextBlock 
            Name="ResultTextBlock"
            Text="Please select item and order type.." 
            HorizontalAlignment="Center"
                   ></TextBlock>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="10"
            Margin="0 30 0 0" HorizontalAlignment="Center">
            <Button Grid.Column="0" Content="Place Order" 
                    Click="PlaceButton_Click"
                    CornerRadius="10"
                    FontSize="17"
                    FontWeight="DemiBold"
                    Background="Black"
                    Foreground="White" >
                <Button.Styles><Style Selector="Button:pointerover/template/ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="Black"></Setter>
                    <Setter Property="Foreground" Value = "White"></Setter>
                </Style></Button.Styles>
            </Button>
            <Button Grid.Column="1" Content="Clear" 
                    Click="ClearButton_Click"
                    CornerRadius="10"
                    FontSize="17"
                    FontWeight="DemiBold"
                    Background="White"
                    Foreground="Black" >
                <Button.Styles><Style Selector="Button:pointerover/template/ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="White"></Setter>
                    <Setter Property="Foreground" Value = "Black"></Setter>
                </Style></Button.Styles>
            </Button>
           
        </Grid>
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
    </StackPanel>
</Window>
