<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Form2Practice5.MainWindow"
        Title="Student Portal">
    <!-- Student Welcome Form

    Create a form with:
    - A TextBox for the student's name.
    - A TextBox for the university ID.
    - A Button labeled Submit.
    - A TextBlock to display the result.
    Requirements: When clicked, 
    display Welcome, [name]! in the TextBlock.
     If the name is empty, show a MessageBox or dialog asking the user to enter their name.
    -->
    <StackPanel Background="#E0E0E0">
        
        <StackPanel  Width="300" 
                        
                     Margin="150,100,150,150"
        >
                <Label Content="Student Name:" Margin="0"></Label>

                <TextBox 
                    x:Name = "StdName"
                    Margin="10"
                    BorderBrush="Black"
                    PlaceholderText="Enter Student Name"
                
                >
                <TextBox.Styles>
                    <Style Selector="TextBox:pointerover/template/Border">
                        <Setter Property="BorderThickness" Value="1" >
                        </Setter>
                        <Setter Property="BorderBrush" Value="RoyalBlue" />
                      
                    </Style>
                </TextBox.Styles>
                           
            </TextBox>
                <Label Content="Student ID:" Margin="0"></Label>
            <TextBox  
                x:Name = "StdId"
                Margin="10"
                BorderBrush="Black"
                PlaceholderText="Enter Student ID"
               
            >
                <TextBox.Styles>
                    <Style Selector="TextBox:pointerover/template/Border">
                    <Setter Property="BorderThickness" Value="1"></Setter>
                    <Setter Property="BorderBrush" Value="RoyalBlue" />
                    
                        
                </Style>
                </TextBox.Styles>
                           
            </TextBox>
              <TextBox IsReadOnly="True"
                       Name="ResultTextBlock"
                   
                       TextWrapping="Wrap"
                       MaxWidth="200"
                       MinWidth="100"></TextBox>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
             <Button 
                 Grid.Column="0"
                 Click="SubmitButton_Click"
                 Content="Submit"
                 Background="Black"
                 Foreground="White"
                 FontWeight="Bold"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="15"
                 Width="100"
                 HorizontalContentAlignment="Center"
                >
                 <Button.Styles>
                     <Style Selector="Button:pointerover/template/ContentPresenter#PART_ContentPresenter">
                         <Setter Property="Background" Value="White"></Setter>
                         <Setter Property="Foreground" Value="Black"></Setter>

                     </Style>
                 </Button.Styles>
             </Button>
                <Button 
                    Grid.Column="1"
                    Click="ClearButton_Click"
                    Content="Clear"
                    Background="Black"
                    Foreground="White"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="15"
                    Width="100"
                    HorizontalContentAlignment="Center"
                >
                    <Button.Styles>
                        <Style Selector="Button:pointerover/template/ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="White"></Setter>
                            <Setter Property="Foreground" Value="Black"></Setter>

                        </Style>
                    </Button.Styles>
                </Button>
            </Grid>
                
                
            </StackPanel>
                        
        </StackPanel>
        
        
        
        
        
        
        
        
        
        
</Window>
